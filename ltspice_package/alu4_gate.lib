* alu4_gate.lib  4-bit ALU, transistor level: gate-level cells (NAND-based XOR, multiplexer and full adder)
* Subcircuit alu4_gate; pins: a_0..a_3, b_0..b_3, s_0..s_2, y_0..y_3, c, v, z, n, vdd, vss
* (index 0 is the least significant bit). Operation select s_2 s_1 s_0:
*   000 ADD   001 SUB   010 INC   011 DEC   100 AND   101 OR   110 XOR   111 NOT (of a)
* Flags: c carry out (1 = no borrow for SUB and DEC), v signed overflow, z result zero,
* n result negative; c and v are 0 for the logic operations.
* 60 cell instances, 842 transistors. Cells used (cells_gate.lib):
*   gate_xor2 x 10, gate_buf x 5, gate_mux2 x 20, gate_fa x 4, gate_and2 x 5, gate_or2 x 4, gate_inv x 8, gate_nor2 x 4
* Requires: .include tsmc018.lib and the cell files named above.

.subckt alu4_gate a_0 a_1 a_2 a_3 b_0 b_1 b_2 b_3 s_0 s_1 s_2 y_0 y_1 y_2 y_3 c v z n vdd vss
Xu_xor21 s_1 s_0 cy_0 vdd vss gate_xor2
Xu_buf1 s_2 s2b vdd vss gate_buf
Xu_buf2 s_0 s0b_0 vdd vss gate_buf
Xu_buf3 s_0 s0b_1 vdd vss gate_buf
Xu_buf4 s_1 s1b_0 vdd vss gate_buf
Xu_buf5 s_1 s1b_1 vdd vss gate_buf
Xu_xor22 b_0 s0b_0 bxs_0 vdd vss gate_xor2
Xu_mux21 bxs_0 s0b_0 s1b_0 bx_0 vdd vss gate_mux2
Xu_fa1 a_0 bx_0 cy_0 sum_0 cy_1 vdd vss gate_fa
Xu_and21 a_0 b_0 land_0 vdd vss gate_and2
Xu_or21 a_0 b_0 lor_0 vdd vss gate_or2
Xu_xor23 a_0 b_0 lxor_0 vdd vss gate_xor2
Xu_inv1 a_0 lnot_0 vdd vss gate_inv
Xu_mux22 land_0 lor_0 s0b_0 m0_0 vdd vss gate_mux2
Xu_mux23 lxor_0 lnot_0 s0b_0 m1_0 vdd vss gate_mux2
Xu_mux24 m0_0 m1_0 s1b_0 lg_0 vdd vss gate_mux2
Xu_mux25 sum_0 lg_0 s2b y_0 vdd vss gate_mux2
Xu_xor24 b_1 s0b_0 bxs_1 vdd vss gate_xor2
Xu_mux26 bxs_1 s0b_0 s1b_0 bx_1 vdd vss gate_mux2
Xu_fa2 a_1 bx_1 cy_1 sum_1 cy_2 vdd vss gate_fa
Xu_and22 a_1 b_1 land_1 vdd vss gate_and2
Xu_or22 a_1 b_1 lor_1 vdd vss gate_or2
Xu_xor25 a_1 b_1 lxor_1 vdd vss gate_xor2
Xu_inv2 a_1 lnot_1 vdd vss gate_inv
Xu_mux27 land_1 lor_1 s0b_0 m0_1 vdd vss gate_mux2
Xu_mux28 lxor_1 lnot_1 s0b_0 m1_1 vdd vss gate_mux2
Xu_mux29 m0_1 m1_1 s1b_0 lg_1 vdd vss gate_mux2
Xu_mux210 sum_1 lg_1 s2b y_1 vdd vss gate_mux2
Xu_xor26 b_2 s0b_1 bxs_2 vdd vss gate_xor2
Xu_mux211 bxs_2 s0b_1 s1b_1 bx_2 vdd vss gate_mux2
Xu_fa3 a_2 bx_2 cy_2 sum_2 cy_3 vdd vss gate_fa
Xu_and23 a_2 b_2 land_2 vdd vss gate_and2
Xu_or23 a_2 b_2 lor_2 vdd vss gate_or2
Xu_xor27 a_2 b_2 lxor_2 vdd vss gate_xor2
Xu_inv3 a_2 lnot_2 vdd vss gate_inv
Xu_mux212 land_2 lor_2 s0b_1 m0_2 vdd vss gate_mux2
Xu_mux213 lxor_2 lnot_2 s0b_1 m1_2 vdd vss gate_mux2
Xu_mux214 m0_2 m1_2 s1b_1 lg_2 vdd vss gate_mux2
Xu_mux215 sum_2 lg_2 s2b y_2 vdd vss gate_mux2
Xu_xor28 b_3 s0b_1 bxs_3 vdd vss gate_xor2
Xu_mux216 bxs_3 s0b_1 s1b_1 bx_3 vdd vss gate_mux2
Xu_fa4 a_3 bx_3 cy_3 sum_3 cy_4 vdd vss gate_fa
Xu_and24 a_3 b_3 land_3 vdd vss gate_and2
Xu_or24 a_3 b_3 lor_3 vdd vss gate_or2
Xu_xor29 a_3 b_3 lxor_3 vdd vss gate_xor2
Xu_inv4 a_3 lnot_3 vdd vss gate_inv
Xu_mux217 land_3 lor_3 s0b_1 m0_3 vdd vss gate_mux2
Xu_mux218 lxor_3 lnot_3 s0b_1 m1_3 vdd vss gate_mux2
Xu_mux219 m0_3 m1_3 s1b_1 lg_3 vdd vss gate_mux2
Xu_mux220 sum_3 lg_3 s2b y_3 vdd vss gate_mux2
Xu_inv5 cy_4 cyn vdd vss gate_inv
Xu_nor21 s2b cyn c vdd vss gate_nor2
Xu_xor210 cy_3 cy_4 vxn_n vdd vss gate_xor2
Xu_inv6 vxn_n vxn vdd vss gate_inv
Xu_nor22 s2b vxn v vdd vss gate_nor2
Xu_nor23 y_0 y_1 zn_0 vdd vss gate_nor2
Xu_nor24 y_2 y_3 zn_1 vdd vss gate_nor2
Xu_and25 zn_0 zn_1 z vdd vss gate_and2
Xu_inv7 y_3 nn vdd vss gate_inv
Xu_inv8 nn n vdd vss gate_inv
.ends alu4_gate
