Xl_c_0 c ld_c_0 vld 0 inv_x1
Xl_c_1 c ld_c_1 vld 0 inv_x1
Xl_c_2 c ld_c_2 vld 0 inv_x1
Xl_c_3 c ld_c_3 vld 0 inv_x1
Xl_v_0 v ld_v_0 vld 0 inv_x1
Xl_v_1 v ld_v_1 vld 0 inv_x1
Xl_v_2 v ld_v_2 vld 0 inv_x1
Xl_v_3 v ld_v_3 vld 0 inv_x1
Xl_z_0 z ld_z_0 vld 0 inv_x1
Xl_z_1 z ld_z_1 vld 0 inv_x1
Xl_z_2 z ld_z_2 vld 0 inv_x1
Xl_z_3 z ld_z_3 vld 0 inv_x1
Xl_n_0 n ld_n_0 vld 0 inv_x1
Xl_n_1 n ld_n_1 vld 0 inv_x1
Xl_n_2 n ld_n_2 vld 0 inv_x1
Xl_n_3 n ld_n_3 vld 0 inv_x1
* decimal words for plotting and measuring: operands, operation, result, flags (8c+4v+2z+n)
Baw aw 0 V=(1*V(a_0)+2*V(a_1)+4*V(a_2)+8*V(a_3))/1.8
Bbw bw 0 V=(1*V(b_0)+2*V(b_1)+4*V(b_2)+8*V(b_3))/1.8
Bsw sw 0 V=(V(s_0)+2*V(s_1)+4*V(s_2))/1.8
Byw yw 0 V=(1*V(y_0)+2*V(y_1)+4*V(y_2)+8*V(y_3))/1.8
Bfw fw 0 V=(8*V(c)+4*V(v)+2*V(z)+V(n))/1.8
.save V(aw) V(bw) V(sw) V(yw) V(fw) V(a_0) V(a_1) V(a_2) V(a_3) V(b_0) V(b_1) V(b_2) V(b_3) V(s_0)
+ V(s_1) V(s_2) V(y_0) V(y_1) V(y_2) V(y_3) V(c) V(v) V(z) V(n) I(Vdut)
.tran 10p 165n 0 20p
.meas tran y01 FIND V(yw) AT=9.75n
.meas tran f01 FIND V(fw) AT=9.75n
.meas tran y02 FIND V(yw) AT=14.75n
.meas tran f02 FIND V(fw) AT=14.75n
.meas tran y03 FIND V(yw) AT=19.75n
.meas tran f03 FIND V(fw) AT=19.75n
