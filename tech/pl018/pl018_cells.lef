MACRO pl_inv
  CLASS CORE ;
  FOREIGN pl_inv 0.000 0.000 ;
  ORIGIN 0.000 0.000 ;
  SIZE 2.400 BY 8.000 ;
  SYMMETRY X Y ;
  SITE plcore ;
  PIN A
    DIRECTION INPUT ;
    PORT
      LAYER metal1 ;
        RECT 0.200 3.300 0.600 3.700 ;
        RECT 0.200 3.300 1.200 3.700 ;
    END
  END A
  PIN Y
    DIRECTION OUTPUT ;
    PORT
      LAYER metal1 ;
        RECT 1.800 3.300 2.200 3.700 ;
        RECT 1.200 0.600 1.600 1.100 ;
        RECT 1.200 1.100 1.800 1.400 ;
        RECT 1.500 1.400 1.800 3.300 ;
        RECT 1.500 3.300 2.200 3.700 ;
        RECT 1.500 3.700 1.800 5.400 ;
        RECT 1.200 5.400 1.800 5.700 ;
        RECT 1.200 5.700 1.600 7.400 ;
    END
  END Y
  PIN vdd
    DIRECTION INOUT ;
    USE POWER ;
    SHAPE ABUTMENT ;
    PORT
      LAYER metal1 ;
        RECT 0.400 5.400 0.800 7.700 ;
        RECT 0.000 7.700 2.400 8.300 ;
    END
  END vdd
  PIN gnd
    DIRECTION INOUT ;
    USE GROUND ;
    SHAPE ABUTMENT ;
    PORT
      LAYER metal1 ;
        RECT 0.000 -0.300 2.400 0.300 ;
        RECT 0.400 0.300 0.800 1.400 ;
    END
  END gnd
  OBS
    LAYER metal1 ;
      RECT 1.100 0.400 1.300 0.600 ;
      RECT 1.100 1.400 1.300 1.600 ;
      RECT 1.100 2.400 1.300 2.600 ;
      RECT 1.100 4.400 1.300 4.600 ;
      RECT 1.100 7.400 1.300 7.600 ;
      RECT 1.900 0.400 2.100 0.600 ;
      RECT 1.900 1.400 2.100 1.600 ;
      RECT 1.900 2.400 2.100 2.600 ;
      RECT 1.900 4.400 2.100 4.600 ;
      RECT 1.900 5.400 2.100 5.600 ;
      RECT 1.900 6.400 2.100 6.600 ;
      RECT 1.900 7.400 2.100 7.600 ;
  END
END pl_inv

