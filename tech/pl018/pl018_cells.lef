      LAYER metal1 ;
        RECT 0.000 7.700 0.800 8.300 ;
    END
  END vdd
  PIN gnd
    DIRECTION INOUT ;
    USE GROUND ;
    SHAPE ABUTMENT ;
    PORT
      LAYER metal1 ;
        RECT 0.000 -0.300 0.800 0.300 ;
    END
  END gnd
END pl_fill

END LIBRARY
