# Xschem start-up file of the project schematics (demo/xschem), passed by demo/show.sh with
# xschem --rcfile: the project symbols of this directory (pl018_*.sym) and the device library
# of the installation (pins, labels, supply symbols); light colours for the projector.
set pl018_dir [file dirname [file normalize [info script]]]
set pl018_paths [list $pl018_dir]
if {[info exists XSCHEM_SHAREDIR]} {
    lappend pl018_paths [file join $XSCHEM_SHAREDIR xschem_library devices]
}
if {[info exists XSCHEM_LIBRARY_PATH]} {
    foreach p [split $XSCHEM_LIBRARY_PATH :] {
        if {$p ne {} && [lsearch -exact $pl018_paths $p] < 0} { lappend pl018_paths $p }
    }
}
set XSCHEM_LIBRARY_PATH [join $pl018_paths :]
set netlist_dir [file normalize [file join $pl018_dir .. out xschem]]
file mkdir $netlist_dir
set netlist_type spice
set dark_colorscheme 0
